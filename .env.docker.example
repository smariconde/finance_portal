# Local PostgreSQL for this project. Copy to .env.docker.local.
# One server holds four databases: POSTGRES_DB is the owner's, the integration
# suite gets finance_portal_test beside it (created by scripts/init-test-db.sh),
# and trading gets finance_portal_trading and finance_portal_trading_test
# (scripts/init-trading-db.sh, ADR 0076).
POSTGRES_USER=finance_portal
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=finance_portal_personal
POSTGRES_PORT=55432
# Local login of the trading runtime role (DML only). Empty leaves it NOLOGIN.
TRADING_RUNTIME_PASSWORD=replace-with-another-local-only-password
