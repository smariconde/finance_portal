# Local PostgreSQL for this project. Copy to .env.docker.local.
# One server holds two databases: POSTGRES_DB is the owner's, and the integration
# suite gets finance_portal_test beside it (created by scripts/init-test-db.sh).
POSTGRES_USER=finance_portal
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=finance_portal_personal
POSTGRES_PORT=55432
