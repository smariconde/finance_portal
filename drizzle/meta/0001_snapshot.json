      "checkConstraints": {
        "ingestion_runs_counts_non_negative_check": {
          "name": "ingestion_runs_counts_non_negative_check",
          "value": "\"ingestion_runs\".\"fetched_count\" >= 0 and \"ingestion_runs\".\"accepted_count\" >= 0 and \"ingestion_runs\".\"rejected_count\" >= 0 and \"ingestion_runs\".\"duplicate_count\" >= 0"
        },
        "ingestion_runs_counts_balance_check": {
          "name": "ingestion_runs_counts_balance_check",
          "value": "\"ingestion_runs\".\"status\" in ('running', 'failed') or \"ingestion_runs\".\"accepted_count\" + \"ingestion_runs\".\"rejected_count\" + \"ingestion_runs\".\"duplicate_count\" = \"ingestion_runs\".\"fetched_count\""
        },
        "ingestion_runs_open_run_check": {
          "name": "ingestion_runs_open_run_check",
          "value": "(\"ingestion_runs\".\"status\" = 'running') = (\"ingestion_runs\".\"finished_at\" is null)"
        },
        "ingestion_runs_finished_after_started_check": {
          "name": "ingestion_runs_finished_after_started_check",
          "value": "\"ingestion_runs\".\"finished_at\" is null or \"ingestion_runs\".\"finished_at\" >= \"ingestion_runs\".\"started_at\""
        },
        "ingestion_runs_failure_check": {
          "name": "ingestion_runs_failure_check",
          "value": "(\"ingestion_runs\".\"status\" = 'failed') = (\"ingestion_runs\".\"failure_code\" is not null and \"ingestion_runs\".\"failure_message\" is not null and \"ingestion_runs\".\"failure_retryable\" is not null)"
        },
        "ingestion_runs_content_hash_check": {
          "name": "ingestion_runs_content_hash_check",
          "value": "case when \"ingestion_runs\".\"status\" in ('running', 'failed') then \"ingestion_runs\".\"content_hash\" is null else \"ingestion_runs\".\"content_hash\" ~ '^[a-f0-9]{64}$' end"
        },
        "ingestion_runs_idempotency_key_check": {
          "name": "ingestion_runs_idempotency_key_check",
          "value": "\"ingestion_runs\".\"idempotency_key\" ~ '^[a-f0-9]{64}$'"
        }
      },
      "isRLSEnabled": false
