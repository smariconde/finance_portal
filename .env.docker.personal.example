# Local PostgreSQL for the owner's personal runtime. Copy to
# .env.docker.personal.local. Kept separate from .env.docker.local because the
# integration database is disposable by contract and this one is not.
POSTGRES_USER=finance_portal_personal
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=finance_portal_personal
POSTGRES_PORT=55433
