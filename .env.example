# Public configuration. Never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Portal Financiero

# Safe default: `locked` serves no data at all. See ADR 0004.
# `personal` is the only mode that serves data and needs BOTH a private runtime
# boundary below AND a pooled DATABASE_URL; anything short of that stays locked.
APP_ENV=development
APP_MODE=locked
# public: never serves data; local: personal outside a hosting platform;
# protected: personal behind platform protection, in any environment.
# `protected` is the owner's declaration, not something the app can verify.
# Turn the platform's protection on BEFORE declaring it. On Vercel Hobby,
# Standard Protection does not cover the production domain: declaring
# `protected` there would put real data on a public URL.
APP_RUNTIME_ACCESS=public
LOG_LEVEL=info
# `next dev` only: comma-separated hosts allowed to load dev chunks and HMR,
# e.g. this machine's LAN IP. Without it a page opened by IP renders without JS.
# Anyone on that network can then use the dev server, personal data included.
DEV_ALLOWED_ORIGINS=

# Server-only database connections. Required by personal mode and migration/test jobs.
DATABASE_URL=
DATABASE_DIRECT_URL=
# Dedicated disposable PostgreSQL database for integration tests only.
DATABASE_TEST_URL=

# Trading database (ADR 0076): a separate database for the Schwab account and
# the trading journal, never the analysis one. Optional: without it the rest of
# the portal is unchanged and /configuracion names the missing variable.
# Runtime: pooled, as the DML-only role finance_portal_trading_runtime.
# Direct: the owner's connection, read only by `pnpm db:trading:migrate`.
# Local, Production and the trading test suite only; Preview never gets them.
TRADING_DATABASE_URL=
TRADING_DATABASE_DIRECT_URL=
# Dedicated disposable database for `pnpm test:integration:trading` only.
TRADING_DATABASE_TEST_URL=
CRON_SECRET=

# Personal market-data configuration. A locked runtime ignores all of it.
MARKET_DATA_PROVIDER=alpaca
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
MARKET_DATA_MAX_REQUESTS_PER_MINUTE=100
MARKET_DATA_MAX_REQUESTS_PER_RUN=1000

# How this runtime identifies itself to the SEC. Required for every source that
# asks for the owner's contact: without it those requests are refused (ADR 0009). SEC Fair Access
# wants a real, reachable contact, so the value must carry an email address and
# only printable ASCII. Form: "Portal Financiero you@example.com". Sources that
# identify as the project (the AI layer) do not need it.
SEC_USER_AGENT=

# AI layer (ADR 0033). Only the keys live here: the egress adds them as a bearer
# header, so no adapter ever sees them. Models, maximum prices, ZDR and
# data_collection=deny are fixed in code (ai-model-ladder-1.0.0) and cannot be
# relaxed from the environment. Spend is capped in code too (USD 0.10 per task,
# USD 1.00 per UTC day); also set a credit limit on the key in the OpenRouter
# account. Check the chain with `pnpm ai:smoke`.
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Catálogo API-INDEC (ADR 0069). The JWT generated in the owner's account at
# api.indec.gob.ar: the egress adds it as a bearer header for `indec-api` only.
# It expires 12 months after it is generated and regenerating it revokes the
# previous one (docs/runbooks/indec-token.md).
INDEC_API_TOKEN=

# Company logos (ADR 0062). A logo.dev *publishable* key (pk_...): it is meant
# for the browser and ends up in the HTML, so it is not a secret. Restrict it to
# your domains in the logo.dev dashboard. Anything that is not pk_... is
# ignored. Empty: every company shows its monogram and no third party is called.
LOGO_DEV_PUBLISHABLE_KEY=

# Optional observability.
SENTRY_DSN=
